    "brilliant-msg": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/web-bluetooth": "^0.0.21",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.41.1"
